   "steps": [
    {
     "name": "gui_check",
     "cmd": [
      "{exe}",
      "--gui-check",
      "{out}/gui"
     ],
     "cwd": "{out}",
     "timeout_s": 900,
     "expect_files": [
      "{out}/gui/icon_256.png",
      "{out}/gui/gui.json",
      "{out}/gui/window.png"
     ]
    },
    {
     "name": "作业单_HS200",
     "cmd": [
      "{python}",
      "-c",
      "import json,sys;json.dump(dict(feature=sys.argv[1],input=sys.argv[2],output=sys.argv[3],run=True,params=json.loads(sys.argv[5])),open(sys.argv[4],'w',encoding='utf-8'))",
      "HS200_halftone_dll",
      "{assets}/in",
      "{out}/out_dll",
      "{out}/job_dll.json",
      "{\"size_mm_float\": 3.0, \"orient_mode_str\": \"original\", \"sdk_check_str\": \"strict\"}"
     ],
     "cwd": "{out}",
     "timeout_s": 60,
     "expect_files": [
      "{out}/job_dll.json"
     ]
    },
    {
     "name": "真作业_HS200_dll加网",
     "cmd": [
      "{exe}",
      "--gui-check",
      "{out}/gui_dll",
      "{out}/job_dll.json"
     ],
     "cwd": "{out}",
     "timeout_s": 1800,
     "expect_files": [
      "{out}/out_dll/**/000000.bmp",
      "{out}/gui_dll/gui.json"
     ]
    },
    {
     "name": "作业单_HR200",
     "cmd": [
      "{python}",
      "-c",
      "import json,sys;json.dump(dict(feature=sys.argv[1],input=sys.argv[2],output=sys.argv[3],run=True,params=json.loads(sys.argv[5])),open(sys.argv[4],'w',encoding='utf-8'))",
      "HR200_simulate_bmp",
      "{out}/out_dll",
      "{out}/out_sim",
      "{out}/job_sim.json",
      "{\"sim_ppm_float\": 20.0, \"sim_engine_str\": \"dll\"}"
     ],
     "cwd": "{out}",
     "timeout_s": 60,
     "expect_files": [
      "{out}/job_sim.json"
     ]
    },
    {
     "name": "真作业_HR200_仿真",
     "cmd": [
      "{exe}",
      "--gui-check",
      "{out}/gui_sim",
      "{out}/job_sim.json"
     ],
     "cwd": "{out}",
     "timeout_s": 1800,
     "expect_files": [
      "{out}/out_sim/**/contact_sheet.png",
      "{out}/out_sim/**/*.glb"
     ]
    },
    {
     "name": "HR100 原始朝向 Python 出片",
     "cmd": [
      "{exe}",
      "--cli",
      "HR100_halftone_print",
      "{assets}/in",
      "{out}/out_python",
      "--param",
      "target_mm_float=3.0",
      "--param",
      "orient_mode_str=original",
      "--param",
      "halftone_method_str=water_transfer_depth"
     ],
     "timeout_s": 1200,
     "cwd": "{out}",
     "expect_files": [
      "{out}/out_python/**/000308.bmp"
     ]
    },
    {
     "name": "逐层对照及仿真文件核验",
     "cmd": [
      "{python}",
      "{assets}/verify_products.py",
      "{out}",
      "{assets}/../manifest.json"
     ],
     "timeout_s": 90,
     "cwd": "{out}",
     "expect_out": [
      "RIP_ACCEPTANCE"
     ],
     "expect_files": [
      "{out}/release_acceptance.json"
     ]
    }
   ],
